# Copie para .env.local (local) e cadastre as mesmas variáveis na Vercel.
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Aceita o nome novo (PUBLISHABLE) ou o antigo (ANON)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable
# Chave secreta: só no servidor. Usada para abrir os links públicos de compartilhamento.
SUPABASE_SECRET_KEY=sua-chave-secret
